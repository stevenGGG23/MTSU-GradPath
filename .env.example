# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# --- Required ---

# Flask secret key — any long random string (e.g. run: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace_with_a_long_random_string

# Supabase Postgres connection string
# Find it in: Supabase dashboard → Project Settings → Database → Connection string → Session pooler
# Use the Session pooler host (aws-0-<region>.pooler.supabase.com:5432), not the direct
# db.[ref].supabase.co host — Supabase's direct host requires an IPv6-capable network or a paid
# IPv4 add-on, which most dev machines/CI/Render don't have.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- Optional ---

# Override which MTSU catalog IDs to sync (default: 36)
# MTSU_CATALOG_IDS=36

# Override the MTSU catalog base URL
# MTSU_CATALOG_URL=https://catalog.mtsu.edu

# HTML scraper fallback catalog IDs (used when widget API returns 401)
# MTSU_HTML_CATOID=33
# MTSU_HTML_NAVOID=7425

# SQLAlchemy connection pool size per process (default: 3 pool + 2 overflow).
# workers x (DB_POOL_SIZE + DB_MAX_OVERFLOW) must stay under Supabase's connection limit.
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2

# HTTP Basic Auth for the expensive force-resync path (/sync?force=1 and the
# legacy bare GET /sync). Leave unset in local dev; set both in production
# (Render env vars) so force-resync isn't publicly triggerable. The normal
# "Sync Catalog" button is unaffected — it never forces a re-scrape.
# SYNC_ADMIN_USER=
# SYNC_ADMIN_PASSWORD=
